#!/bin/sh
# Refuse any push to the remote branch main or master (this includes force pushes and deletions).
# git calls this with the remote name and URL as arguments and one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Enable: git config core.hooksPath scripts/git-hooks   (see docs/development.md)
# Server-side branch protection on main is the stronger option; this only stops accidents from this clone.

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "pre-push: refusing to push '$local_ref' to '$remote_ref'. Push a feature branch and open a pull request." >&2
            status=1
            ;;
    esac
done
exit $status
