<?xml version='1.0'?>
<workbook>
  <preferences>
    <preference name='ui.shelf.height' value='30' />
    <color-palette name="Acme Brand" type="regular">
      <color>#112233</color>
      <color>#445566</color>
    </color-palette>
    <color-palette name="Retail Teal" type="ordered-sequential">
      <color>#E0F2F1</color>
      <color>#00796B</color>
    </color-palette>
  </preferences>
  <unknown-thing keep="me" />
</workbook>
